{
  "name": "mobile-lowfi-framework-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "prebuild": "node scripts/mlp-loop-review.mjs && node scripts/write-version.mjs",
    "build": "vite build",
    "mlp:review": "node scripts/mlp-loop-review.mjs",
    "mlp:annotation-acceptance": "node scripts/mlp-annotation-acceptance.mjs",
    "mlp:fast-check": "npm run build",
    "preview": "vite preview --host 0.0.0.0",
    "mlp:framework-sync": "node scripts/mlp-skill-command.mjs sync",
    "mlp:migrate-full": "node scripts/mlp-skill-command.mjs migrate",
    "mlp:release": "node scripts/mlp-skill-command.mjs release",
    "mlp:versions": "node scripts/mlp-skill-command.mjs versions",
    "mlp:rollback": "node scripts/mlp-skill-command.mjs rollback",
    "mlp:access": "node scripts/mlp-skill-command.mjs access",
    "mlp:runtime-review": "node scripts/mlp-runtime-review.mjs",
    "mlp:route-check": "npm run mlp:fast-check && npm run mlp:runtime-review",
    "mlp:visual-review": "node scripts/mlp-visual-review.mjs",
    "mlp:acceptance": "npm run mlp:route-check && npm run mlp:annotation-acceptance",
    "mlp:visual-acceptance": "npm run mlp:acceptance && npm run mlp:visual-review",
    "mlp:split-modules": "node scripts/mlp-skill-command.mjs split",
    "mlp:visual-snapshot": "node scripts/mlp-visual-review.mjs --snapshot-only",
    "mlp:framework-patch": "node scripts/mlp-skill-command.mjs patch",
    "mlp:export-ai": "node scripts/mlp-export-ai-handoff.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.6.0",
    "vite": "^7.2.7",
    "typescript": "^5.9.3",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "lucide-react": "^0.561.0",
    "html2canvas": "^1.4.1"
  },
  "devDependencies": {}
}
